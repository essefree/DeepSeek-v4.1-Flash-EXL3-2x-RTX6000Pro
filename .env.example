# DeepSeek-V4.1-Flash EXL3 2.9 bpw — one host, 2× RTX PRO 6000 Blackwell (96 GB, SM120)
# Copy to .env and edit. ./start.sh does this for you on first run.
#
# Fork of the 2× DGX Spark recipe. There is no worker node, no CX7/RoCE, no
# NFS share and no image shipping: one container, both GPUs, TP=2 over PCIe.

# --- GPUs --------------------------------------------------------------------
# Which two GPUs the container sees (docker --gpus). "all" or e.g. '"device=0,1"'.
GPUS=all
# PCIe P2P between the cards. RTX PRO 6000 supports it, but some boards / IOMMU
# setups hang ncclCommInitRank or the custom all-reduce. If boot hangs at NCCL
# init or the first forward: NCCL_P2P_DISABLE=1 and DISABLE_CUSTOM_ALL_REDUCE=1.
NCCL_P2P_DISABLE=0
DISABLE_CUSTOM_ALL_REDUCE=0

# --- weights ---------------------------------------------------------------
# EXL3 weights (39 shards, ~197 GiB) and the Engram tables (shards 47+48 of the
# original 48-shard checkpoint, ~95 GiB each). ./start.sh fetches whatever is
# missing; ./download.sh does the same without starting the server.
HF_MODEL_REPO=Mia-AiLab/DeepSeek-V4.1-Flash-EXL3-2.9bpw
HF_ENGRAM_REPO=deepseek-ai/DeepSeek-V4.1-Flash
AUTO_DOWNLOAD=1
# MODEL_HOST=./model
ENGRAM_DIR=./engram-src
EXPECTED_SHARDS=39

# --- VRAM budget (the part that differs from the Sparks) --------------------
# At TP=2 the checkpoint is 99.5 GiB per rank; a 96 GB card has 95.6 GiB.
# The routed experts of these layers live in pinned host RAM and are read over
# PCIe (UVA zero-copy) — see overlay/exl3.py "Host-resident routed experts".
#   per layer per rank: ~2.38 GiB (K=3), ~1.59 GiB (K=2 layers 18-22)
#   33-39 -> 82.9 GiB on each GPU, 16.6 GiB pinned host RAM per rank (33 GiB total)
#   34-39 -> 85.2 GiB on each GPU (try after a clean boot: faster decode, less margin)
# Every offloaded layer costs decode speed (PCIe ~50 GB/s vs GDDR7 1.8 TB/s).
# Check a spec with: python3 scripts/weight_budget.py --host-expert-layers 33-39
DSV41_EXL3_HOST_EXPERT_LAYERS=33-39
# VRAM that must be free on each GPU after the GPU-resident weights at boot.
DSV41_BOOT_MARGIN_GIB=8

# --- serve -------------------------------------------------------------------
# No public x86 image: start.sh builds this tag from the Dockerfile (≈20-40 min
# the first time) and rebuilds only when Dockerfile/overlay/files/tests change.
IMAGE=dsv41-flash-exl3-rtx6000:2.9bpw
PORT=8888
TP=2
QUANTIZATION=exl3
ENFORCE_EAGER=0
EXL3_FUSED_MOE=1
EXL3_FAT_KERNEL=0
EXL3_FAT_GROUPED=1
EXL3_TEMP_ROWS_FUSED=16
SERVED_MODEL_NAME=DeepSeek-v4.1-Flash-EXL3

# In-checkpoint DSpark. k=3 was the Spark measurement; re-measure here
# (the GPUs are ~6x faster, so the best k may differ).
SPEC_METHOD=dspark
DSPARK_TOKENS=3

# Context. The Sparks shipped 600k on ~13 GiB of GPU-side headroom; with 33-39
# offloaded each card has ~12 GiB, so start at 256k and raise after a long-prompt
# test (watch the [dsv41-mem] cuda_free lines in ./start.sh logs).
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=1536
# LONG_PREFILL_TOKEN_THRESHOLD=1280
# Only vLLM's startup check here (KV pool is pinned below): free VRAM at init
# must be >= util x 95.6 GiB.
GPU_MEM_UTIL=0.80
# Pinned KV pool (~3.4 KiB/token in this build). 2.5 GiB = ~774k tokens.
KV_CACHE_MEMORY_BYTES=2684354560
KV_BLOCK_SIZE=64
PREFIX_CACHE_RETENTION_INTERVAL=4096

# --- Engram (host side; on a discrete GPU this is ordinary RAM, not VRAM) -----
# The tables are read from ENGRAM_DIR through the page cache. With 256 GB of
# RAM most of the ~190 GiB stays cached after warm-up. Resident scales pin
# ~1.5 GiB/layer/rank of host RAM (6 GiB total) and save one read per miss.
DSV41_CACHE_GIB=0
DSV41_RESIDENT_SCALES=1
# Engram row-read threads PER RANK (two ranks share one CPU here). 96 was the
# GB10 setting; on a 24-core / 48-thread Threadripper PRO 9965WX, 2 x 32 leaves
# cores for vLLM's own threads. Raise if prefill is Engram-read bound.
DSV41_IO_THREADS=32

# Vision (see README "Images"). Set 1 for a text-only server (saves 0.9 GiB VRAM/rank).
LANGUAGE_MODEL_ONLY=0
SKIP_MM_PROFILING=1
LIMIT_MM='{"image":100}'

# --- API auth --------------------------------------------------------------
# VLLM_API_KEY=

# --- runtime ----------------------------------------------------------------
DSV41_BOOT_SHAPE_WARMUP=1
GLM53_SUPPRESS_STOPS_IN_REASONING=1
GLM53_MIXED_PREFILL_CHUNK=0
GLM53_SPINWAIT_MS=stock
NCCL_DEBUG=WARN
CG_ESTIMATE=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# Free VRAM (not host MemAvailable) drives the adaptive prefill release.
DSV41_MEM_SOURCE=cuda
# Page-cache drop after load was a GB10 driver workaround; not needed here.
DSV41_DROP_PAGE_CACHE=0
DSV41_SKIP_MIXED_WARMUP=0
VLLM_DISABLE_SHARED_EXPERTS_STREAM=1
DSV41_EXL3_SERIAL_STREAMS=1
DSV41_INDEXER_PREFILL_FACTOR=1
VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=256
DSV41_PREFILL_EMPTY_CACHE_TOKENS=8192
# Release only while free VRAM after a chunk is below this many GiB.
DSV41_PREFILL_EMPTY_CACHE_MEMAVAIL_GIB=2.0
DSV41_PREFILL_END_EMPTY_CACHE=0
